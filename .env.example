# Local settings for scripts (npm run ingest / eval). Copy to .env and fill in. Never commit .env.
# Path to the preprocessed knowledge base (chunks.jsonl, kept outside the repository)
CHUNKS_PATH=
# Worker to ingest into / evaluate: local `npm run dev:api` or the deployed Worker
WORKER_URL=http://localhost:8787
# Same value as ADMIN_TOKEN in .dev.vars (local) or the Wrangler secret (production)
ADMIN_TOKEN=

# Client (build time, public — not a secret): the Worker URL the page talks to. Dev default: http://localhost:8787
VITE_API_URL=
